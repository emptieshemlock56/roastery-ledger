      "Bash(npm test)",
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(git --version)",
      "Bash(git status)",
      "Bash(git remote -v)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git merge --ff-only *)",
      "Bash(gh auth status)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "PowerShell(npm install)",
      "PowerShell(npm ci)",
      "PowerShell(npm test)",
      "PowerShell(npm run dev)",
      "PowerShell(npm run build)",
      "PowerShell(git status)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)"
