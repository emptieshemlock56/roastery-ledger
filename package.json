{
  "name": "roastery-ledger",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "test": "npm test -w server"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
